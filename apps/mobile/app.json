{
  "expo": {
    "name": "Stride",
    "slug": "stride-workspace",
    "owner": "leoeccentric",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "stride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stride.mobile"
    },
    "android": {
      "package": "com.stride.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1E9",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F4F1E9",
          "dark": {
            "backgroundColor": "#12110F"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Stride listens when you tap the mic, so you can log food by voice."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Stride uses the camera to see your plate or scan a barcode."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stride reads a photo you pick to log the food in it."
        }
      ],
      "expo-localization",
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "d196dbbf-4b00-4bf6-b681-b2b7be4b9b29"
      }
    },
    "icon": "./assets/icon.png",
    "runtimeVersion": { "policy": "fingerprint" },
    "updates": { "url": "https://u.expo.dev/d196dbbf-4b00-4bf6-b681-b2b7be4b9b29" }
  }
}
